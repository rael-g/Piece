---

WarningsAsErrors: '*'
Checks: >
  -*,
  modernize-*,
  readability-braces-around-statements,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-static-definition-in-anonymous-namespace,
  readability-uniqueptr-delete-release,
  performance-move-const-arg,
  performance-no-automatic-move,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  bugprone-argument-comment,
  bugprone-redundant-branch-condition,
  google-explicit-constructor,
  llvm-include-order,
  llvm-namespace-comment,
  -modernize-use-trailing-return-type,
  readability-identifier-naming
HeaderFilterRegex: '.*'

FormatStyle: file

CheckOptions:
  # ============================================================================
  # ===== Naming Conventions =====
  # ============================================================================
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.ClassCaseForEnums
    value: CamelCase
  - key: readability-identifier-naming.ClassCaseForStructs
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: snake_case
  - key: readability-identifier-naming.MemberCase
    value: snake_case
  - key: readability-identifier-naming.ConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstantMemberCase
    value: CamelCase
  - key: readability-identifier-naming.ConstantMemberPrefix
    value: k
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k


  # ============================================================================
  # ===== C++ Core Guidelines & Modernization =====
  # ============================================================================
  # Enforce RAII and modern smart pointer creation.
  - key: modernize-use-make-shared
    value: 'true'
  - key: modernize-use-make-unique
    value: 'true'
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  - key: modernize-use-using.IgnoreMacros
    value: 'true'

  # Relax some strict pointer rules often needed in low-level engine code.
  - key: cppcoreguidelines-pro-bounds-pointer-arithmetic
    value: 'false'
  - key: cppcoreguidelines-pro-type-reinterpret-cast
    value: 'false'

  # ============================================================================
  # ===== Readability & Style =====
  # ============================================================================
  # Enforce const-correctness aggressively.
  - key: readability-const-correctness-call-argument
    value: 'true'
  - key: readability-const-correctness-member-fn
    value: 'true'
  - key: readability-const-correctness-return-type
    value: 'true'
  - key: readability-const-correctness-variable
    value: 'true'
  
  # Enforce braces around statements for clarity and bug prevention.
  - key: readability-braces-around-statements.ShortStatementLines
    value: '0'

  # Avoid magic numbers, but allow them for floating point values in graphics code.
  - key: cppcoreguidelines-avoid-magic-numbers.IgnoreAllFloatingPointValues
    value: 'true'
