<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeTarget>piece_core</NativeTarget>
    <PackageId>Piece.Core</PackageId>
    <Version>0.0.1</Version>
    <Description>Core functionality for the Piece framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Piece.Core.Abstractions\Piece.Core.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <Import Project="../build/NativeDependencies.targets"/>

</Project>
