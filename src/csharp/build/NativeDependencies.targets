<Project>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <NativeOS>linux</NativeOS>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <NativeOS>osx</NativeOS>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <NativeOS>win</NativeOS>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration) == 'Debug'">
    <NativeConfig>debug</NativeConfig>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration) == 'Release'">
    <NativeConfig>release</NativeConfig>
  </PropertyGroup>

  <PropertyGroup>
    <NativeArch>x64</NativeArch>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'arm64'">
    <NativeArch>arm64</NativeArch>
  </PropertyGroup>

  <PropertyGroup>
    <NativePreset>$(NativeOS)-$(NativeArch)-$(NativeConfig)</NativePreset>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <NativeExt>so</NativeExt>
    <NativePre>lib</NativePre>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <NativeExt>dylib</NativeExt>
    <NativePre>lib</NativePre>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <NativeExt>dll</NativeExt>
    <NativePre></NativePre>
  </PropertyGroup>

  <PropertyGroup>
    <PiecePackageDir>$(MSBuildThisFileDirectory)..\..\..\</PiecePackageDir>
    <NativeBinDir>$(PiecePackageDir)\build\native\bin</NativeBinDir>
    <NativeTargetBinary>$(NativeBinDir)\$(NativePre)$(NativeTarget).$(NativeExt)</NativeTargetBinary>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeTargetBinary)" Condition="Exists('$(NativeTargetBinary)')">
      <Pack>true</Pack>
      <PackagePath>runtimes/$(NativeOS)-$(NativeArch)/native/</PackagePath>
    </None>
  </ItemGroup>

</Project>