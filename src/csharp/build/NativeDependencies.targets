<Project>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <NativeOS>linux</NativeOS>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <NativeOS>osx</NativeOS>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <NativeOS>windows</NativeOS>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration) == 'Debug'">
    <NativeConfig>debug</NativeConfig>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration) == 'Release'">
    <NativeConfig>release</NativeConfig>
  </PropertyGroup>

  <PropertyGroup>
    <NativePreset>$(NativeOS)-$(NativeConfig)</NativePreset>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <NativeExt>so</NativeExt>
    <NativePre>lib</NativePre>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <NativeExt>dylib</NativeExt>
    <NativePre>lib</NativePre>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <NativeExt>dll</NativeExt>
    <NativePre></NativePre>
  </PropertyGroup>

  <PropertyGroup>
    <PiecePackageDir>$(MSBuildThisFileDirectory)..\..\..\</PiecePackageDir>
    <NativeBinDir>$(PiecePackageDir)\build\native\bin</NativeBinDir>
    <VcpkgInstalledDir>$(PiecePackageDir)\build\$(NativePreset)\vcpkg_installed\</VcpkgInstalledDir>
  </PropertyGroup>

  <PropertyGroup>
    <NativeBuildSentinel>$(PiecePackageDir)\build\$(NativePreset)\.native_configure_completed</NativeBuildSentinel>
  </PropertyGroup>

  <Target Name="BuildNative" BeforeTargets="Build">
    <Message Text="Checking if native CMake configuration is required for preset $(NativePreset)..." Importance="high" />
    <Exec Condition="!Exists('$(NativeBuildSentinel)')"
          Command="cmake --preset $(NativePreset)"
          WorkingDirectory="$(PiecePackageDir)" />
    <WriteLinesToFile
        Condition="!Exists('$(NativeBuildSentinel)')"
        File="$(NativeBuildSentinel)"
        Lines="Completed at $([System.DateTime]::Now)"
        Overwrite="true" />

    <Message Text="Building native target $(NativeTarget) for preset $(NativePreset)..." Importance="high" />
    <Exec
          Command="cmake --build --preset $(NativePreset) --target $(NativeTarget) --verbose"
          WorkingDirectory="$(PiecePackageDir)" />
    <Exec
          Command="cmake --install build/$(NativePreset) --prefix build/native --config $(NativeConfig)"
          WorkingDirectory="$(PiecePackageDir)" />
  </Target>

  <PropertyGroup>
    <NativeArch Condition="'$(NativeArch)' == ''">x64</NativeArch> <!-- Default for most platforms -->
  </PropertyGroup>

  <PropertyGroup>
    <VcpkgTriplet>$(NativeArch)-$(NativeOS)</VcpkgTriplet>
  </PropertyGroup>

  <PropertyGroup>
    <NativeDepDir Condition="'$(Configuration)'=='Debug'">$(VcpkgInstalledDir)$(VcpkgTriplet)\debug\bin</NativeDepDir>
    <NativeDepDir Condition="'$(Configuration)'!='Debug'">$(VcpkgInstalledDir)$(VcpkgTriplet)\bin</NativeDepDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeBinDir)\$(NativePre)$(NativeTarget).$(NativeExt)" Condition="Exists('$(NativeBinDir)\$(NativePre)$(NativeTarget).$(NativeExt)')">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="@(NativeLibraryDependency->'$(NativeDepDir)\$(NativePre)%(Identity).$(NativeExt)')">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>