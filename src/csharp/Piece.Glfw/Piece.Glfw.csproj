<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeTarget>wal_glfw</NativeTarget>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Piece.Glfw</PackageId>
    <Version>0.0.1</Version>
    <Description>GLFW windowing integration for the Piece framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Piece.Core" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <NativeLibraryDependency Include="glfw3" />
  </ItemGroup>

  <Import Project="../build/NativeDependencies.targets"/>

</Project>